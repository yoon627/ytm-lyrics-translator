{
  "manifest_version": 3,
  "name": "YTM Lyrics Translator (dev)",
  "version": "0.1.0",
  "description": "YouTube Music synced lyrics translated by Claude (personal dev build)",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://lrclib.net/*", "https://api.anthropic.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["src/main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["src/overlay.js", "src/content.js"],
      "css": ["src/overlay.css"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
